{
    "name": "djneo92nl/beo-mozart-php",
    "type": "library",
    "description": "Pure PHP client for the Bang & Olufsen Mozart platform REST API and WebSocket notification feed.",
    "license": "MIT",
    "version": "0.1.0",
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-sockets": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Djneo92nl\\BeoMozart\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Djneo92nl\\BeoMozart\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
