APP_NAME=ReMoment
APP_ENV=production
APP_KEY={{ vault_app_key }}
APP_DEBUG=false
APP_URL={{ app_url }}

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=remoment
DB_USERNAME=remoment
DB_PASSWORD={{ vault_db_password | default('remoment') }}

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
# The app container uses host networking (multicast discovery), so Redis is on loopback.
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

MQTT_HOST={{ mqtt_host }}
MQTT_PORT={{ mqtt_port }}
MQTT_CLIENT_ID={{ mqtt_client_id }}
# Broker host/port advertised to client devices via GET /api/info.
# Empty = the host the client used to reach the HTTP server.
MQTT_PUBLIC_HOST={{ mqtt_public_host | default('') }}
MQTT_PUBLIC_PORT={{ mqtt_public_port | default(1883) }}

# Own audio files are streamed to speakers from here; empty = APP_URL. Must be reachable by the speakers.
STREAM_BASE_URL={{ stream_base_url | default('') }}

# Spotify stream (docs/architecture/spotify-stream.md): docker compose --profile spotify-stream up -d
LIBRESPOT_ENABLED={{ librespot_enabled | default('false') }}
LIBRESPOT_NAME="{{ librespot_name | default('ReMoment Stream') }}"
LIBRESPOT_EVENT_SECRET={{ vault_librespot_event_secret | default('remoment') }}
ICECAST_PORT={{ icecast_port | default(8000) }}
# One MP3 per Spotify track for renderers that show per-item art (experimental, UPnP only): true + the container's port.
LIBRESPOT_TRACKS={{ librespot_tracks | default('false') }}
LIBRESPOT_TRACK_PORT={{ librespot_track_port | default(8010) }}
ICECAST_SOURCE_PASSWORD={{ vault_icecast_source_password | default('remoment') }}
ICECAST_ADMIN_PASSWORD={{ vault_icecast_admin_password | default('remoment') }}
# Radio relay (docs/architecture/radio-relay.md): docker compose --profile radio-relay up -d
RADIO_RELAY_ENABLED={{ radio_relay_enabled | default('false') }}
RADIO_RELAY_BITRATE={{ radio_relay_bitrate | default(128) }}
RADIO_RELAY_MAX={{ radio_relay_max | default(4) }}

# Browser live updates over MQTT-over-WebSocket (empty ws_url = derived from the request host).
MQTT_PUBLIC_WS_PORT={{ mqtt_public_ws_port | default(9001) }}
MQTT_WS_URL={{ mqtt_ws_url | default('') }}

# Metadata sources (docs/architecture/metadata-enrichment.md).
METADATA_USER_AGENT="{{ metadata_user_agent }}"
SPOTIFY_CLIENT_ID={{ vault_spotify_client_id | default('') }}
SPOTIFY_CLIENT_SECRET={{ vault_spotify_client_secret | default('') }}
LASTFM_API_KEY={{ vault_lastfm_api_key | default('') }}
LASTFM_SHARED_SECRET={{ vault_lastfm_shared_secret | default('') }}
DISCOGS_TOKEN={{ vault_discogs_token | default('') }}
AUDIODB_API_KEY={{ vault_audiodb_api_key | default('123') }}

# Audio analysis (docs/architecture/audio-analysis.md). COMPOSE_PROFILES starts the Essentia sidecar (analysis)
# and the structure service (structure); the app runs host-networked, so it reaches them on loopback.
{% set compose_profiles = (['analysis'] if analysis_enabled | bool else []) + (['structure'] if structure_enabled | bool else []) %}
{% if compose_profiles %}
COMPOSE_PROFILES={{ compose_profiles | join(',') }}
{% endif %}
{% if analysis_enabled | bool %}
ANALYSIS_ENABLED=true
ANALYSIS_ESSENTIA_URL=http://127.0.0.1:8090
ANALYSIS_ESSENTIA_ML={{ 'true' if analysis_essentia_ml | bool else 'false' }}
ANALYSIS_ESSENTIA_ML_BUILD={{ 1 if analysis_essentia_ml | bool else 0 }}
ANALYSIS_MOOD_MIN_SCORE={{ analysis_mood_min_score }}
ACOUSTID_API_KEY={{ acoustid_api_key }}
ACOUSTID_MIN_SCORE={{ acoustid_min_score }}
{% else %}
ANALYSIS_ENABLED=false
{% endif %}

# Structure service: sections of one track on demand (docs/architecture/structure-service.md).
{% if structure_enabled | bool %}
STRUCTURE_URL=http://127.0.0.1:8091
{% endif %}

# Used by Docker Compose for volume permission matching
WWWUSER={{ app_uid }}
WWWGROUP={{ app_gid }}
APP_PORT={{ app_port }}
QUEUE_WORKERS={{ queue_workers }}
MUSIC_DIR={{ music_dir }}
LIBRARY_DIR={{ library_dir }}
