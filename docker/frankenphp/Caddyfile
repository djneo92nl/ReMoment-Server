{
	# A plain-HTTP LAN appliance: no certificates, no admin API.
	admin off
	auto_https off
	persist_config off
	frankenphp {
		# PHP threads. Default is 2 x CPU; a Pi 2 (1 GB) stays small.
		num_threads {$FRANKENPHP_THREADS:4}
	}
}

:{$APP_PORT:80} {
	root * /var/www/html/public

	# Uploads at /settings/storage are one XHR; keep in step with upload_max_filesize/post_max_size in php.ini.
	request_body {
		max_size 300MB
	}

	php_server
}
