[Unit]
Description=ReMoment Node
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/remoment-node -config /etc/remoment-node.json
Restart=on-failure
# exit status 2 = the server does not know the token any more: do not loop, an admin has to look
RestartPreventExitStatus=2
RestartSec=5
DynamicUser=yes
StateDirectory=remoment-node
Environment=REMOMENT_NODE_STATE_DIR=/var/lib/remoment-node
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=64M

[Install]
WantedBy=multi-user.target
