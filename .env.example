APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"



# --- Profile: control | standard | full ---
PROFILE=full

# --- Audio analysis (own files; Full profile) ---
ANALYSIS_ENABLED=true
ANALYSIS_QUEUE=analysis
ANALYSIS_BATCH=100
ANALYSIS_SCAN_BATCH=25
ANALYSIS_NIGHT_HOURS=6
ANALYSIS_TIMEOUT=900
ANALYSIS_WAVEFORM_POINTS=400
ANALYSIS_MOOD_MIN_SCORE=0.7
# Essentia sidecar (BPM, key, mood)
ANALYSIS_ESSENTIA_URL=
ANALYSIS_ESSENTIA_ML=false
ANALYSIS_ESSENTIA_TIMEOUT=600
FFMPEG_BINARY=ffmpeg
FPCALC_BINARY=fpcalc
ACOUSTID_MIN_SCORE=0.9

# --- Deep analysis on demand (compose profiles `structure` and `stems`) ---
# Sections (librosa)
STRUCTURE_URL=
STRUCTURE_TIMEOUT=240
STRUCTURE_DECODE_RATE=22050
STRUCTURE_SECONDS_FIXED=2
STRUCTURE_SECONDS_PER_SECOND=0.012
# Stems (Demucs)
STEMS_URL=
STEMS_QUEUE=stems
STEMS_TIMEOUT=3000
STEMS_RAM_MB=1500
STEMS_SECONDS_FIXED=5
STEMS_SECONDS_PER_SECOND=0.5

# --- Export (zip for MP3 player / car radio) ---
EXPORT_DISK=local
EXPORT_QUEUE=heavy
EXPORT_DEFAULT_PROFILE=mp3-320
EXPORT_MAX_GB=8
EXPORT_PART_GB=4
EXPORT_DIR_MAX_GB=16
EXPORT_KEEP_HOURS=24
EXPORT_FREE_MARGIN_MB=256
EXPORT_TIMEOUT=14400
EXPORT_FILE_TIMEOUT=600
EXPORT_NICE=10

# --- Transcode proxies ---
PROXIES_ENABLED=true
PROXIES_DISK=local
PROXIES_QUEUE=heavy
PROXIES_MAX_MB=2048
PROXIES_TIMEOUT=600

# --- Spotify on any speaker (librespot + Icecast, compose profile) ---
LIBRESPOT_ENABLED=false
LIBRESPOT_NAME="ReMoment Stream"
LIBRESPOT_EVENT_SECRET=change-me
LIBRESPOT_TRACKS=false
LIBRESPOT_TRACK_PORT=8010
ICECAST_PORT=8000
ICECAST_INTERNAL_URL=http://127.0.0.1:8000
ICECAST_MOUNT=spotify.mp3
ICECAST_SOURCE_PASSWORD=change-me
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=change-me
STREAM_BASE_URL=

# --- B&O multiroom on any speaker (compose profile) ---
BEOLINK_ENABLED=false
BEOLINK_NAME="ReMoment Stream"
BEOLINK_API_URL=http://127.0.0.1:8081
ICECAST_BEOLINK_MOUNT=beolink.mp3

# --- Radio relay ---
RADIO_RELAY_ENABLED=false
RADIO_RELAY_MAX=4
RADIO_RELAY_BITRATE=128
RADIO_RELAY_IDLE_SECONDS=60
RADIO_RELAY_LIVE_WAIT_SECONDS=15
RADIO_RELAY_USER_AGENT=ReMoment/1.0

# --- Sync groups (fake multiroom) / move playback ---
SYNC_CHECK_INTERVAL=3
SYNC_DRIFT_THRESHOLD=2
SYNC_SEEK_COOLDOWN=6
SYNC_TRACK_CHANGE_DELAY=4
PLAYBACK_MOVE_WAIT_SECONDS=10

# --- Alerts ---
ALERTS_DEVICE_OFFLINE_MINUTES=10
ALERTS_LISTENER_DOWN_MINUTES=3
ALERTS_RESOLVE_AFTER_MINUTES=2

# --- Backup / upgrade ---
BACKUP_KEEP=7
# BACKUP_PATH=
UPGRADE_DISK_MARGIN_MB=100
UPGRADE_HEALTH_INTERVAL=5

# --- Artwork ---
ARTWORK_RECENT_ALBUMS=500
ARTWORK_PRERENDER_MAX_JOBS=100

# --- Devices ---
DEVICE_AUTO_DISCOVER=true

# --- External service keys (can also be entered at /settings/services) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
DISCOGS_TOKEN=
ACOUSTID_API_KEY=
AUDIODB_API_KEY=123
METADATA_USER_AGENT="ReMoment/1.0 (you@example.com)"

# --- MQTT (public address for clients) ---
MQTT_PUBLIC_HOST=
MQTT_PUBLIC_WS_PORT=9001
# MQTT_WS_URL=

# --- SQLite (Control profile) ---
DB_BUSY_TIMEOUT=10000
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL
DB_TRANSACTION_MODE=IMMEDIATE
