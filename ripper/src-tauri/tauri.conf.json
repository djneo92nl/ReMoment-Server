{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReMoment Ripper",
  "version": "0.1.0",
  "identifier": "nl.remoment.ripper",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "title": "ReMoment Ripper", "width": 720, "height": 560 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
