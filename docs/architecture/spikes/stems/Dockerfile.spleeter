# Throw-away Spleeter spike image (16.4). TensorFlow 2.12.1 needs Python <= 3.11.
FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 OMP_NUM_THREADS=4 TF_CPP_MIN_LOG_LEVEL=2
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir spleeter==2.4.2 && pip list 2>/dev/null | grep -i -E "^(tensorflow|spleeter|numpy|pandas|norbert)"
WORKDIR /work
